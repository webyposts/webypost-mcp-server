# ── MCP HTTP server ──────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── Webypost target ──────────────────────────────────────────
WEBYPOST_BASE_URL=https://webypost.com

# ── Multi-account (recommended for Grok) ─────────────────────
# One MCP URL can post as many Webypost users. Grok passes account="<id>".
# JSON object: key = account id, value = { email, password }
#
# Example (paste as ONE line on Render, or multi-line in .env):
WEBYPOST_ACCOUNTS={"main":{"email":"you@example.com","password":"secret1"},"brand":{"email":"brand@example.com","password":"secret2"},"news":{"email":"news@example.com","password":"secret3"}}

# Which account to use when Grok omits the account argument
WEBYPOST_DEFAULT_ACCOUNT=main

# Default privacy for posts: Public | Private | Friends
WEBYPOST_DEFAULT_PRIVACY=Public

# HTTP timeout (ms)
WEBYPOST_TIMEOUT_MS=30000

# ── Legacy single-account (optional; ignored if WEBYPOST_ACCOUNTS is set) ──
# WEBYPOST_EMAIL=your-email@example.com
# WEBYPOST_PASSWORD=your-password
# WEBYPOST_SESSION_COOKIE=PHPSESSID=abc123; wyp_remember=def456
