# ── MCP HTTP server ──────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── Webypost target ──────────────────────────────────────────
# Production:
WEBYPOST_BASE_URL=https://webypost.com
# Local XAMPP (when Apache is running):
# WEBYPOST_BASE_URL=http://localhost/webypost

# Account used by check_webypost_status + publish_webypost_post
WEBYPOST_EMAIL=your-email@example.com
WEBYPOST_PASSWORD=your-password

# Optional: skip password login and reuse a browser session cookie string
# WEBYPOST_SESSION_COOKIE=PHPSESSID=abc123; wyp_remember=def456

# Default privacy for posts: Public | Private | Friends
WEBYPOST_DEFAULT_PRIVACY=Public

# HTTP timeout (ms)
WEBYPOST_TIMEOUT_MS=30000
